<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/title_main"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/statusCard"
            style="@style/CardStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                style="@style/TitleTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_main" />

            <TextView
                android:id="@+id/statusText"
                style="@style/StatusTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/status_disconnected"
                android:text="@string/status_not_connected"
                android:textColor="@color/text_white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/debugCard"
            style="@style/CardStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                style="@style/TitleTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_debug" />

            <TextView
                android:id="@+id/connectionStateText"
                style="@style/DataTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Verbindung: NOT_CONNECTED" />

            <TextView
                android:id="@+id/authStateText"
                style="@style/DataTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Auth: RX_KEY_ID" />

            <TextView
                android:id="@+id/creditsText"
                style="@style/DataTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Credits: 0" />

            <TextView
                android:id="@+id/deviceText"
                style="@style/DataTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Geraet: noch keins" />

            <TextView
                android:id="@+id/lastFrameText"
                style="@style/DataTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Letzter TIO-RX-Frame: --" />

        </LinearLayout>

        <Button
            android:id="@+id/advertiseButton"
            style="@style/ButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/button_start_advertising" />

        <Button
            android:id="@+id/disconnectButton"
            style="@style/ButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/error"
            android:text="@string/button_disconnect"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
